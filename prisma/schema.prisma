generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                       String                   @id @default(uuid())
  email                    String                   @unique
  passwordHash             String                   @map("password_hash")
  status                   UserStatus               @default(active)
  emailVerifiedAt          DateTime?                @map("email_verified_at")
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")
  pendingEmail             String?                  @unique @map("pending_email")
  ambassadorApprovals      Ambassador[]             @relation("AmbassadorApprover")
  ambassador               Ambassador?
  approvalRequestsMade     ApprovalRequest[]        @relation("ApprovalRequester")
  approvalRequestsReviewed ApprovalRequest[]        @relation("ApprovalReviewer")
  attempts                 Attempt[]                @relation("AttemptUser")
  auditLogs                AuditLog[]
  careerListingsCreated    CareerListing[]          @relation("CareerListingCreator")
  certificatesIssued       Certificate[]            @relation("CertificateIssuer")
  certificatesRevoked      Certificate[]            @relation("CertificateRevoker")
  certificatesReceived     Certificate[]            @relation("CertificateRecipient")
  contactReplies           ContactReply[]
  contactSubmissions       ContactSubmission[]
  contentAuthored          Content[]                @relation("ContentAuthor")
  conversations            Conversation[]           @relation("ConversationParticipant")
  emailVerificationTokens  EmailVerificationToken[]
  messagesSent             Message[]                @relation("MessageSender")
  notificationPreference   NotificationPreference?
  notifications            Notification[]
  paymentsReviewed         OlympiadPayment[]        @relation("PaymentReviewer")
  paymentsMade             OlympiadPayment[]        @relation("PaymentPayer")
  olympiadRegistrations    OlympiadRegistration[]
  olympiadsCreated         Olympiad[]               @relation("OlympiadCreator")
  organisationTeamMembers  OrganisationTeamMember[] @relation("OrganisationTeamMemberCreator")
  participant              Participant?
  passwordResetTokens      PasswordResetToken[]
  popupsCreated            Popup[]                  @relation("PopupCreator")
  popups                   Popup[]                  @relation("PopupUser")
  profile                  Profile?
  questionArchiveFolders   QuestionArchiveFolder[]  @relation("QuestionArchiveFolderCreator")
  questionArchives         QuestionArchive[]        @relation("QuestionArchiveCreator")
  lettersIssued            RecommendationLetter[]   @relation("LetterIssuer")
  lettersRevoked           RecommendationLetter[]   @relation("LetterRevoker")
  lettersReceived          RecommendationLetter[]   @relation("LetterRecipient")
  sessions                 Session[]
  rolesAssigned            UserRole[]               @relation("UserRoleAssignedBy")
  userRoles                UserRole[]               @relation("UserRoleUser")

  @@map("users")
}

model Profile {
  id                String           @id @default(uuid())
  userId            String           @unique @map("user_id")
  fullName          String           @map("full_name")
  phone             String?
  avatarUrl         String?          @map("avatar_url")
  bio               String?
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")
  preferredLanguage QuestionLanguage @default(en) @map("preferred_language")
  user              User             @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("profiles")
}

model Role {
  id              String           @id @default(uuid())
  key             String           @unique
  label           String
  rank            Int
  createdAt       DateTime         @default(now()) @map("created_at")
  rolePermissions RolePermission[]
  userRoles       UserRole[]

  @@map("roles")
}

model Permission {
  id              String           @id @default(uuid())
  key             String           @unique
  description     String
  createdAt       DateTime         @default(now()) @map("created_at")
  rolePermissions RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String     @map("role_id")
  permissionId String     @map("permission_id")
  permission   Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)
  role         Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model UserRole {
  userId         String   @map("user_id")
  roleId         String   @map("role_id")
  assignedBy     String?  @map("assigned_by")
  assignedAt     DateTime @default(now()) @map("assigned_at")
  assignedByUser User?    @relation("UserRoleAssignedBy", fields: [assignedBy], references: [id])
  role           Role     @relation(fields: [roleId], references: [id], onDelete: Cascade)
  user           User     @relation("UserRoleUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Session {
  id        String   @id
  userId    String   @map("user_id")
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address") @db.Inet
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at")
  usedAt    DateTime? @map("used_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("email_verification_tokens")
}

model Notification {
  id        String    @id @default(uuid())
  userId    String    @map("user_id")
  type      String
  title     String
  body      String?
  metadata  Json?
  readAt    DateTime? @map("read_at")
  createdAt DateTime  @default(now()) @map("created_at")
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model NotificationPreference {
  userId       String   @id @map("user_id")
  emailEnabled Boolean  @default(true) @map("email_enabled")
  inAppEnabled Boolean  @default(true) @map("in_app_enabled")
  updatedAt    DateTime @updatedAt @map("updated_at")
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notification_preferences")
}

model ApprovalRequest {
  id          String         @id @default(uuid())
  type        String
  targetType  String         @map("target_type")
  targetId    String         @map("target_id")
  requestedBy String         @map("requested_by")
  status      ApprovalStatus @default(pending)
  reviewedBy  String?        @map("reviewed_by")
  reviewedAt  DateTime?      @map("reviewed_at")
  reason      String?
  metadata    Json?
  createdAt   DateTime       @default(now()) @map("created_at")
  requester   User           @relation("ApprovalRequester", fields: [requestedBy], references: [id], onDelete: Cascade)
  reviewer    User?          @relation("ApprovalReviewer", fields: [reviewedBy], references: [id])

  @@map("approval_requests")
}

model AuditLog {
  id         String   @id @default(uuid())
  actorId    String?  @map("actor_id")
  action     String
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address") @db.Inet
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  actor      User?    @relation(fields: [actorId], references: [id])

  @@map("audit_logs")
}

model Participant {
  id            String              @id @default(uuid())
  userId        String              @unique @map("user_id")
  institution   String?
  gradeLevel    String?             @map("grade_level")
  createdAt     DateTime            @default(now()) @map("created_at")
  gender        String?
  district      String?
  address       String?
  city          String?
  academicLevel String?             @map("academic_level")
  referral      AmbassadorReferral?
  user          User                @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("participants")
}

model Ambassador {
  id          String               @id @default(uuid())
  userId      String               @unique @map("user_id")
  institution String?
  region      String?
  status      AmbassadorStatus     @default(pending)
  approvedBy  String?              @map("approved_by")
  createdAt   DateTime             @default(now()) @map("created_at")
  referrals   AmbassadorReferral[]
  approver    User?                @relation("AmbassadorApprover", fields: [approvedBy], references: [id])
  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ambassadors")
}

model AmbassadorReferral {
  id            String      @id @default(uuid())
  ambassadorId  String      @map("ambassador_id")
  participantId String      @unique @map("participant_id")
  createdAt     DateTime    @default(now()) @map("created_at")
  ambassador    Ambassador  @relation(fields: [ambassadorId], references: [id], onDelete: Cascade)
  participant   Participant @relation(fields: [participantId], references: [id], onDelete: Cascade)

  @@map("ambassador_referrals")
}

model ContactSubmission {
  id        String         @id @default(uuid())
  name      String
  email     String
  subject   String
  category  String
  message   String
  userId    String?        @map("user_id")
  status    ContactStatus  @default(open)
  createdAt DateTime       @default(now()) @map("created_at")
  updatedAt DateTime       @updatedAt @map("updated_at")
  replies   ContactReply[]
  user      User?          @relation(fields: [userId], references: [id])

  @@map("contact_submissions")
}

model ContactReply {
  id           String            @id @default(uuid())
  submissionId String            @map("submission_id")
  staffUserId  String            @map("staff_user_id")
  body         String
  createdAt    DateTime          @default(now()) @map("created_at")
  staffUser    User              @relation(fields: [staffUserId], references: [id], onDelete: Cascade)
  submission   ContactSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  @@map("contact_replies")
}

model Conversation {
  id                String             @id @default(uuid())
  participantUserId String             @map("participant_user_id")
  status            ConversationStatus @default(open)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  participant       User               @relation("ConversationParticipant", fields: [participantUserId], references: [id], onDelete: Cascade)
  messages          Message[]

  @@map("conversations")
}

model Message {
  id             String       @id @default(uuid())
  conversationId String       @map("conversation_id")
  senderUserId   String       @map("sender_user_id")
  body           String
  createdAt      DateTime     @default(now()) @map("created_at")
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender         User         @relation("MessageSender", fields: [senderUserId], references: [id], onDelete: Cascade)

  @@map("messages")
}

model Olympiad {
  id                       String                   @id @default(uuid())
  title                    String
  slug                     String                   @unique
  description              String?
  subject                  String?
  status                   OlympiadStatus           @default(draft)
  durationMinutes          Int                      @map("duration_minutes")
  startAt                  DateTime?                @map("start_at")
  endAt                    DateTime?                @map("end_at")
  publishAt                DateTime?                @map("publish_at")
  negativeMarkingEnabled   Boolean                  @default(false) @map("negative_marking_enabled")
  negativeMarkingValue     Float                    @default(0) @map("negative_marking_value")
  resultsPublishedAt       DateTime?                @map("results_published_at")
  createdBy                String                   @map("created_by")
  createdAt                DateTime                 @default(now()) @map("created_at")
  updatedAt                DateTime                 @updatedAt @map("updated_at")
  eligibilityMode          String                   @default("open") @map("eligibility_mode")
  eligibilityGradeLevel    String?                  @map("eligibility_grade_level")
  eligibilityInstitution   String?                  @map("eligibility_institution")
  eligibilityAcademicLevel String?                  @map("eligibility_academic_level")
  registrationStartAt      DateTime?                @map("registration_start_at")
  registrationEndAt        DateTime?                @map("registration_end_at")
  registrationEnabled      Boolean                  @default(true) @map("registration_enabled")
  posterUrl                String?                  @map("poster_url")
  registrationFee          Decimal?                 @map("registration_fee") @db.Decimal(10, 2)
  registrationType         OlympiadRegistrationType @default(free) @map("registration_type")
  attempts                 Attempt[]
  certificates             Certificate[]
  payments                 OlympiadPayment[]
  registrations            OlympiadRegistration[]
  creator                  User                     @relation("OlympiadCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  questions                Question[]

  @@map("olympiads")
}

model Question {
  id                String             @id @default(uuid())
  olympiadId        String             @map("olympiad_id")
  text              String
  imageUrl          String?            @map("image_url")
  subject           String?
  difficulty        QuestionDifficulty @default(medium)
  marks             Float              @default(1)
  order             Int
  explanation       String?
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  archiveQuestionId String?            @map("archive_question_id")
  explanationBn     String?            @map("explanation_bn")
  textBn            String?            @map("text_bn")
  type              QuestionType       @default(mcq)
  answers           AttemptAnswer[]
  options           QuestionOption[]
  archiveQuestion   QuestionArchive?   @relation(fields: [archiveQuestionId], references: [id])
  olympiad          Olympiad           @relation(fields: [olympiadId], references: [id], onDelete: Cascade)

  @@index([olympiadId, order])
  @@index([archiveQuestionId])
  @@map("questions")
}

model QuestionOption {
  id         String          @id @default(uuid())
  questionId String          @map("question_id")
  text       String
  isCorrect  Boolean         @default(false) @map("is_correct")
  order      Int
  textBn     String?         @map("text_bn")
  answers    AttemptAnswer[]
  question   Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@map("question_options")
}

model QuestionArchiveSubject {
  id        String                  @id @default(uuid())
  name      String                  @unique
  createdAt DateTime                @default(now()) @map("created_at")
  updatedAt DateTime                @updatedAt @map("updated_at")
  folders   QuestionArchiveFolder[]
  questions QuestionArchive[]       @relation("QuestionArchiveSubject")

  @@map("question_archive_subjects")
}

model QuestionArchive {
  id            String                  @id @default(uuid())
  type          QuestionType            @default(mcq)
  questionEn    String                  @map("question_en")
  questionBn    String                  @map("question_bn")
  difficulty    QuestionDifficulty      @default(medium)
  marks         Float                   @default(1)
  explanationEn String?                 @map("explanation_en")
  explanationBn String?                 @map("explanation_bn")
  imageUrl      String?                 @map("image_url")
  createdBy     String                  @map("created_by")
  createdAt     DateTime                @default(now()) @map("created_at")
  updatedAt     DateTime                @updatedAt @map("updated_at")
  subjectId     String?                 @map("subject_id")
  folderId      String?                 @map("folder_id")
  options       QuestionArchiveOption[]
  creator       User                    @relation("QuestionArchiveCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  folder        QuestionArchiveFolder?  @relation(fields: [folderId], references: [id])
  subject       QuestionArchiveSubject? @relation("QuestionArchiveSubject", fields: [subjectId], references: [id])
  questions     Question[]

  @@index([type])
  @@index([subjectId])
  @@index([folderId])
  @@index([difficulty])
  @@index([createdAt])
  @@map("question_archives")
}

model QuestionArchiveFolder {
  id        String                  @id @default(uuid())
  subjectId String                  @map("subject_id")
  parentId  String?                 @map("parent_id")
  name      String
  createdBy String                  @map("created_by")
  createdAt DateTime                @default(now()) @map("created_at")
  updatedAt DateTime                @updatedAt @map("updated_at")
  creator   User                    @relation("QuestionArchiveFolderCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  parent    QuestionArchiveFolder?  @relation("QuestionArchiveFolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children  QuestionArchiveFolder[] @relation("QuestionArchiveFolderTree")
  subject   QuestionArchiveSubject  @relation(fields: [subjectId], references: [id], onDelete: Cascade)
  questions QuestionArchive[]

  @@unique([subjectId, parentId, name])
  @@index([subjectId, parentId])
  @@map("question_archive_folders")
}

model QuestionArchiveOption {
  id                String          @id @default(uuid())
  archiveQuestionId String          @map("archive_question_id")
  label             String
  textEn            String          @map("text_en")
  textBn            String          @map("text_bn")
  isCorrect         Boolean         @default(false) @map("is_correct")
  order             Int
  question          QuestionArchive @relation(fields: [archiveQuestionId], references: [id], onDelete: Cascade)

  @@unique([archiveQuestionId, label])
  @@index([archiveQuestionId, order])
  @@map("question_archive_options")
}

model Attempt {
  id                      String          @id @default(uuid())
  olympiadId              String          @map("olympiad_id")
  userId                  String          @map("user_id")
  status                  AttemptStatus   @default(in_progress)
  startedAt               DateTime        @default(now()) @map("started_at")
  deadlineAt              DateTime        @map("deadline_at")
  submittedAt             DateTime?       @map("submitted_at")
  score                   Float?
  totalMarks              Float?          @map("total_marks")
  correctCount            Int?            @map("correct_count")
  incorrectCount          Int?            @map("incorrect_count")
  unansweredCount         Int?            @map("unanswered_count")
  timeSpentSeconds        Int?            @map("time_spent_seconds")
  rank                    Int?
  scoreLocked             Boolean         @default(false) @map("score_locked")
  createdAt               DateTime        @default(now()) @map("created_at")
  updatedAt               DateTime        @updatedAt @map("updated_at")
  integrityViolationCount Int             @default(0) @map("integrity_violation_count")
  autoSubmissionReason    String?         @map("auto_submission_reason")
  autoSubmittedAt         DateTime?       @map("auto_submitted_at")
  legacyAnswers           Json?           @map("legacy_answers")
  manualRank              Int?            @map("manual_rank")
  answers                 AttemptAnswer[]
  olympiad                Olympiad        @relation(fields: [olympiadId], references: [id], onDelete: Cascade)
  user                    User            @relation("AttemptUser", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([olympiadId, userId])
  @@index([olympiadId, manualRank])
  @@map("attempts")
}

model OlympiadRegistration {
  id           String                     @id @default(uuid())
  olympiadId   String                     @map("olympiad_id")
  userId       String                     @map("user_id")
  registeredAt DateTime                   @default(now()) @map("registered_at")
  confirmedAt  DateTime?                  @map("confirmed_at")
  status       OlympiadRegistrationStatus @default(confirmed)
  payments     OlympiadPayment[]
  olympiad     Olympiad                   @relation(fields: [olympiadId], references: [id], onDelete: Cascade)
  user         User                       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([olympiadId, userId])
  @@index([userId])
  @@index([olympiadId, status])
  @@map("olympiad_registrations")
}

model OlympiadPayment {
  id              String               @id @default(uuid())
  olympiadId      String               @map("olympiad_id")
  registrationId  String               @map("registration_id")
  userId          String               @map("user_id")
  method          PaymentMethod        @default(bkash)
  amount          Decimal              @db.Decimal(10, 2)
  senderNumber    String               @map("sender_number")
  transactionId   String               @map("transaction_id")
  status          PaymentStatus        @default(pending)
  reviewedBy      String?              @map("reviewed_by")
  reviewedAt      DateTime?            @map("reviewed_at")
  rejectionReason String?              @map("rejection_reason")
  createdAt       DateTime             @default(now()) @map("created_at")
  updatedAt       DateTime             @updatedAt @map("updated_at")
  olympiad        Olympiad             @relation(fields: [olympiadId], references: [id], onDelete: Cascade)
  registration    OlympiadRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  reviewer        User?                @relation("PaymentReviewer", fields: [reviewedBy], references: [id])
  payer           User                 @relation("PaymentPayer", fields: [userId], references: [id], onDelete: Cascade)

  @@index([olympiadId, status])
  @@index([registrationId, status])
  @@index([transactionId])
  @@index([userId])
  @@map("olympiad_payments")
}

model OrganisationTeamMember {
  id           String   @id @default(uuid())
  name         String
  title        String
  bio          String?
  imageUrl     String?  @map("image_url")
  displayOrder Int      @default(0) @map("display_order")
  active       Boolean  @default(true)
  linkedinUrl  String?  @map("linkedin_url")
  websiteUrl   String?  @map("website_url")
  createdBy    String   @map("created_by")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  creator      User     @relation("OrganisationTeamMemberCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([active, displayOrder])
  @@map("organisation_team_members")
}

model AttemptAnswer {
  id                String          @id @default(uuid())
  attemptId         String          @map("attempt_id")
  questionId        String          @map("question_id")
  selectedOptionId  String?         @map("selected_option_id")
  isCorrect         Boolean?        @map("is_correct")
  marksAwarded      Float?          @map("marks_awarded")
  timeSpentSeconds  Int             @default(0) @map("time_spent_seconds")
  changeCount       Int             @default(0) @map("change_count")
  firstAnsweredAt   DateTime?       @map("first_answered_at")
  lastInteractionAt DateTime?       @map("last_interaction_at")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  attempt           Attempt         @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  question          Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  selectedOption    QuestionOption? @relation(fields: [selectedOptionId], references: [id])

  @@unique([attemptId, questionId])
  @@map("attempt_answers")
}

model Certificate {
  id                String                 @id @default(uuid())
  certificateId     String                 @unique @map("certificate_id")
  verificationToken String                 @unique @map("verification_token")
  userId            String                 @map("user_id")
  olympiadId        String                 @map("olympiad_id")
  attemptId         String?                @map("attempt_id")
  achievement       CertificateAchievement
  status            CertificateStatus      @default(valid)
  fileUrl           String?                @map("file_url")
  issuedBy          String                 @map("issued_by")
  issuedAt          DateTime               @default(now()) @map("issued_at")
  revokedBy         String?                @map("revoked_by")
  revokedAt         DateTime?              @map("revoked_at")
  createdAt         DateTime               @default(now()) @map("created_at")
  updatedAt         DateTime               @updatedAt @map("updated_at")
  issuer            User                   @relation("CertificateIssuer", fields: [issuedBy], references: [id], onDelete: Cascade)
  olympiad          Olympiad               @relation(fields: [olympiadId], references: [id], onDelete: Cascade)
  revoker           User?                  @relation("CertificateRevoker", fields: [revokedBy], references: [id])
  recipient         User                   @relation("CertificateRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@map("certificates")
}

model RecommendationLetter {
  id          String       @id @default(uuid())
  userId      String       @map("user_id")
  title       String       @default("Letter of Recommendation")
  body        String?
  fileUrl     String?      @map("file_url")
  status      LetterStatus @default(draft)
  issuedBy    String       @map("issued_by")
  publishedAt DateTime?    @map("published_at")
  revokedBy   String?      @map("revoked_by")
  revokedAt   DateTime?    @map("revoked_at")
  createdAt   DateTime     @default(now()) @map("created_at")
  updatedAt   DateTime     @updatedAt @map("updated_at")
  issuer      User         @relation("LetterIssuer", fields: [issuedBy], references: [id], onDelete: Cascade)
  revoker     User?        @relation("LetterRevoker", fields: [revokedBy], references: [id])
  recipient   User         @relation("LetterRecipient", fields: [userId], references: [id], onDelete: Cascade)

  @@map("recommendation_letters")
}

model Content {
  id            String        @id @default(uuid())
  kind          ContentKind
  title         String
  slug          String        @unique
  description   String?
  body          String?
  externalUrl   String?       @map("external_url")
  status        ContentStatus @default(draft)
  publishedAt   DateTime?     @map("published_at")
  createdBy     String        @map("created_by")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  coverImageUrl String?       @map("cover_image_url")
  fileUrl       String?       @map("file_url")
  author        User          @relation("ContentAuthor", fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("content")
}

model CareerListing {
  id           String       @id @default(uuid())
  title        String
  department   String?
  description  String
  requirements String?
  status       CareerStatus @default(draft)
  publishAt    DateTime?    @map("publish_at")
  deadline     DateTime?
  createdBy    String       @map("created_by")
  createdAt    DateTime     @default(now()) @map("created_at")
  updatedAt    DateTime     @updatedAt @map("updated_at")
  creator      User         @relation("CareerListingCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@map("career_listings")
}

model Popup {
  id        String    @id @default(uuid())
  content   String
  ctaLabel  String?   @map("cta_label")
  ctaUrl    String?   @map("cta_url")
  active    Boolean   @default(false)
  startAt   DateTime? @map("start_at")
  endAt     DateTime? @map("end_at")
  priority  Int       @default(0)
  createdBy String    @map("created_by")
  createdAt DateTime  @default(now()) @map("created_at")
  updatedAt DateTime  @updatedAt @map("updated_at")
  userId    String?   @map("user_id")
  creator   User      @relation("PopupCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  user      User?     @relation("PopupUser", fields: [userId], references: [id])

  @@map("popups")
}

